# Copy to .env.local for local development. Set the same three variables
# in your Vercel project's Environment Variables for production.

# Postgres connection string (e.g. from Neon, Vercel Postgres, RDS, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# The single shared password used to sign in to the app.
APP_PASSWORD=change-me

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me

# Base URL of the deployed Distributor Rankings companion site
# (github.com/TradeNotti/Distributors.PatrickGroup), used only to build the
# "Copy ranking link" button on a distributor's detail screen. Optional —
# the button is hidden if unset.
VITE_RANKINGS_URL=https://distributors-patrickgroup.vercel.app
